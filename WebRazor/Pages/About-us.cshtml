@page
@model WebRazor.Pages.About_usModel
@{
}

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PetPath HTML</title>
    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">

    <script defer src="/js/main.js"></script>
    <link href="/css/style.css" rel="stylesheet">
</head>

<style>
   .square {
      width: 140px;
      height: 140px;
      background-color: #6c757d;
      border-radius: 10px;
      border: 3px solid white;
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 0 auto;
      position: relative;
      overflow: hidden; 
   }

   .square img {
      width: 100%;
      height: 100%;
      object-fit: cover;
        
   }

   .name {
      font-weight: bold;
      font-size: 16px;
   }

   .role {
      font-weight: bold;
      font-size: 14px;
      color: #6c757d;
   }
</style>

<body>
    @Html.Partial("PageCommon/PageHeader")
    <!-- main start -->
    <main>
        <!-- inner hero section start -->
        <section class="inner-hero-section pt-xxl-0 pt-xs-15 pt-20 pt-120 bg-primary2" style="padding: 0 100px 0 100px;">
            <div class="container position-relative" style="padding: 0px 100px 0px 100px;">
            <div class="row g-6 justify-content-between align-items-center">
               <div class="col-sm-8">
                  <span class="mb-2 text-h1 text-n20">About Us</span>
                  <ul class="breadcrumb d-inline-flex align-items-center justify-content-center gap-lg-2 gap-1">
                        <li class="breadcrumb-item"><a href="index.html">Home</a></li>
                        <li class="breadcrumb-item active"><a href="#">About</a></li>
                  </ul>
               </div>
               <div class="col-xl-2 col-sm-2 me-auto d-none d-sm-block">
                  <div class="reveal-bottom inner-hero-banner text-center d-flex justify-content-center align-items-center"
                     style="width: 400px; height: 250px; margin: 0 auto;">
                     <img class="img-fluid" style="max-width: 70%; max-height: 70%; object-fit: contain;"
                           src="/images/inner-hero-banner.png" alt="inner hero banner">
                  </div>
               </div>
               </div>
               <div class="pows position-absolute top-60 right-n10 translate-middle-y z-n1 d-none d-sm-block">
                  <img class="w-100" src="/images/pows.png" alt="pow" style="max-height: 100px;"> <!-- Giảm chiều cao hình ảnh pow -->
               </div>
            </div>
        </section>
        <!-- inner hero section end -->
        <!-- about us section start -->
      <section class="about-us-section pt-120 pb-120" style="padding: 50px 100px 0px 100px;">
         <div class="container position-relative">
            <div class="two-star position-absolute top-0 end-0">
               <img class="w-100" src="/images/two-star.png" alt="two star">
            </div>
            <div class="row g-6 justify-content-between align-items-center">
               <div class="col-xl-12 col-lg-12">
                  <h2 class="text-animation-word text-n20 fw-bold mb-4" style="font-size: 2.5rem; color: #333;">
                     The SpaceX Journey: A Passion for Pets
                  </h2>
                  <div class="mt-8 mb-2">
                     <span class="text-base text-n10" style="line-height: 1.8;">
                        Welcome to SpaceX – offering quality products for your pets, including food, toys, and accessories.
                     </span>
                  </div>
                  <div class="mb-2">
                     <span class="text-base text-n10" style="line-height: 1.8;">
                        At SpaceX Da Nang, customer and pet satisfaction are our top priorities.
                     </span>
                  </div>
                  <div class="mb-10">
                     <p class="text-base text-n10" style="line-height: 1.8;">
                        We believe pets are family and are committed to providing a pet-friendly environment.
                     </p>
                  </div>

               </div>
            </div>
         </div>
      </section>

        <!-- about us section end -->
        <!-- core value section start -->
         <section class="core-value-section pt-120 pb-120 bg-primary2 mb-8" style="padding: 50px 100px 0px 100px;">
            <div class="container mb-4">
               <div class="text-center mb-4">
                  <h2><strong>Our Team</strong></h2>
               </div>

               <div class="text-center mb-8">
                  <p>
                     SpaceX was founded by FPT University students with a passion for pets.
                  </p>
                  <p>
                     We offer essential pet products and aim to build a community of pet lovers.
                  </p>
                  <p>
                     Let us help you care for your beloved companions with the best shopping experience!
                  </p>
               </div>

            <div class="container mb-10">
               <!-- 5 ô vuông trên cùng 1 hàng -->
               <div class="row row-cols-1 row-cols-md-5 g-4 text-center mb-12">
                  <div class="col">
                     <div class="square mb-4">
                        <img src="/images/avata/Tra My.jpg">
                     </div>
                     <p class="name">Tra My</p>
                     <p class="role">Founder & CEO</p>
                  </div>
                  <div class="col">
                     <div class="square mb-4">
                        <img src="/images/avata/Van Nguyen.jpg">
                     </div>
                     <p class="name">Bao Nguyen</p>
                     <p class="role">Founder & CTO</p>
                  </div>
                  <div class="col">
                     <div class="square mb-4">
                        <img src="/images/avata/Phuong Nhi.jpg">
                     </div>
                     <p class="name">Phuong Nhi</p>
                     <p class="role">COO</p>
                  </div>
                  <div class="col">
                     <div class="square mb-4">
                        <img src="/images/avata/Nhu Loc.jpg">
                     </div>
                     <p class="name">Nhu Loc</p>
                     <p class="role">CPO</p>
                  </div>
                  <div class="col">
                     <div class="square mb-4">
                        <img src="/images/avata/Phuong Dung.jpg">
                     </div>
                     <p class="name">Phuong Dung</p>
                     <p class="role">CMO</p>
                  </div>
               </div>
            </div>

            </div>
         </section>
       
    </main>
    <!-- main end -->
    <!-- footer -->
    <!-- footer section start -->
   <footer class="footer-section pt-60 pb-30" style="padding: 0 70px 0 100px">
      <div class="container">
         <div class="row justify-content-between g-6 pb-lg-10 pb-md-8 pb-6">
            <!-- Column 1: Logo and Social Media Links -->
            <div class="col-md-8 col-lg-8">
               <div class="footer-logo mb-lg-6 mb-4">
                  <a href="index.html">
                     <img class="w-100" src="/images/logo.png" alt="footer logo">
                  </a>
               </div>
               <ul class="d-flex align-items-center gap-lg-2 gap-1">
                  <li>
                     <a href="https://www.facebook.com/profile.php?id=61573568756092" class="icon-40px border n20-border text-xl box-style box-secondary">
                        <i class="ph-fill ph-facebook-logo"></i>
                     </a>
                  </li>
                  <li>
                     <a href="#" class="icon-40px border n20-border text-xl box-style box-secondary">
                        <i class="ph-fill ph-twitter-logo"></i>
                     </a>
                  </li>
                  <li>
                     <a href="#" class="icon-40px border n20-border text-xl box-style box-secondary">
                        <i class="ph-fill ph-instagram-logo"></i>
                     </a>
                  </li>
                  <li>
                     <a href="#" class="icon-40px border n20-border text-xl box-style box-secondary">
                        <i class="ph-fill ph-youtube-logo"></i>
                     </a>
                  </li>
               </ul>
            </div>

            <!-- Column 2: Contact Info -->
            <div class="col-md-4 col-lg-4">
               <div class="footer-menu">
                  <h5 class="text-n20 fw-normal mb-lg-6 mb-4">Contact Info</h5>
                  <ul class="d-grid gap-lg-4 gap-2">
                     <li>
                        <a href="#"
                           class="d-flex align-items-center gap-2 text-n20 fw-normal hover-text-secondary hover-underline">
                           <span class="text-xl"><i class="ph ph-map-pin"></i></span>
                           397 Nguyen Huu Tho, Cam Le, Da Nang
                        </a>
                     </li>
                     <li>
                        <a href="#"
                           class="d-flex align-items-center gap-2 text-n20 fw-normal hover-text-secondary hover-underline">
                           <span class="text-xl"><i class="ph ph-phone-call"></i></span>
                           076 271 6082
                        </a>
                     </li>
                     <li>
                        <a href="#"
                           class="d-flex align-items-center gap-2 text-n20 fw-normal hover-text-secondary hover-underline">
                           <span class="text-xl"><i class="ph ph-envelope-open"></i></span>
                           petshopspacex@gmail.com
                        </a>
                     </li>
                  </ul>
               </div>
            </div>
         </div>
         <span class="d-block border-bottom n100-border1"></span>
         <div class="py-lg-3 py-2 text-center">
            <span class="text-n20 fw-normal">
               © 2022 - <span class="currentYear"></span> | All rights reserved by <strong>SpaceX</strong>
            </span>
         </div>
      </div>
   </footer>

    <!-- footer section end -->

</body>