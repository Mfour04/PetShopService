@page
@model IndexModel
@{
	ViewData["Title"] = "Home page";
}

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>PetPath HTML</title>
	<link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">

	<script defer src="/js/main.js"></script>
	<link href="/css/style.css" rel="stylesheet">
</head>

<body>
	@Html.Partial("PageCommon/PreLoad")
	@Html.Partial("PageCommon/PageHeader")
	@Html.Partial("PageCommon/PageSearchForm")

	<!-- main start -->
	<main>
		<!-- hero section start -->
		<section class="hero-section pt-120 pb-120" style="padding: 150px 100px 0px 100px;">
			<div class="bg-banner position-absolute top-0 start-0 w-100 h-100 z-n1">
				<img class="w-100 h-100" src="/images/hero-bg.png" alt="bg banner">
			</div>
			<div class="container mt-10">
				<div class="row g-6 justify-content-between align-items-center">
					<div class="col-xl-6 col-lg-7 px-lg-0">
						<span class="d-block text-lg fw-medium mb-4">WELCOME TO PETPATH</span>
						<h2 class="text-animation-word display-two text-n20 fw-normal mb-lg-6 mb-4">
							The Best Care for Your Best Friend
						</h2>
						<p class="text-base text-n10 mb-lg-8 mb-md-6 mb-4">
							At PetPath, we provide exceptional care and services for your pets, including grooming,
							boarding, and walking. Trust us to ensure your furry friends are happy.
						</p>
					</div>
					<div class="col-lg-5 px-lg-0">
						<div class="hero-banner position-relative reveal-left overflow-visible">
							<img src="/images/hero-banner.png" alt="hero image">
							<div class="hero-thumb banner-element elementBottom rotateLeft position-absolute start-0">
								<img class="w-100" src="/images/hero-thumb.png" alt="hero thumb">
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
		<!-- hero section end -->
		<!-- service section start -->
		<section class="service-section pt-120 pb-120 mt-10" style="padding: 50px 100px 0px 100px;">
			<div class="container">
				<div class="row justify-content-center mb-lg-15 mb-md-10 mb-8">
					<div class="col-xl-6 col-lg-8 text-center">
						<span class="d-block text-primary text-uppercase mb-lg-4 mb-3">Our Services</span>
						<h2 class="text-animation-word text-h1 text-center font-otomanopee text-n20 fw-normal">
							Our one-stop solution for premium pet care
						</h2>
					</div>
				</div>
				<div class="row g-6 mb-lg-15 mb-md-10 mb-8 justify-content-center justify-content-md-start">
					<div class="col-lg-4 col-md-6 col-xs-10">
						<div class="service-card position-relative text-center py-xl-20 py-lg-15 py-sm-12 py-18 px-xl-10 px-sm-8 px-10 border n20-border radius-circle bg-secondary3 overflow-hidden">
							<div class="dog-paws position-absolute end-0 top-0 me-10 mt-10">
								<img class="w-100" src="/images/dog-paws.png" alt="">
							</div>
							<div class="icon-80px mx-auto radius-0 mb-lg-8 mb-6">
								<img class="w-100" src="/images/service-icon-1.png" alt="dog icon">
							</div>
							<a href="service-details.html"
							   class="text-animation-line text-h3 text-n20 font-otomanopee fw-normal mb-4 hover-underline">
								Dog
								Care
							</a>
							<p class="text-n20">
								Our Dog Care services include grooming, walking, boarding, and training. We ensure your
								furry friend is happy, healthy.
							</p>
						</div>
					</div>
					<div class="col-lg-4 col-md-6 col-xs-10">
						<div class="service-card position-relative text-center py-xl-20 py-lg-15 py-sm-12 py-18 px-xl-10 px-sm-8 px-10 border n20-border radius-circle bg-secondary5 overflow-hidden">
							<div class="dog-paws position-absolute end-0 top-0 me-10 mt-10">
								<img class="w-100" src="/images/dog-paws.png" alt="">
							</div>
							<div class="icon-80px mx-auto radius-0 mb-lg-8 mb-6">
								<img class="w-100" src="/images/service-icon-2.png" alt="dog icon">
							</div>
							<a href="service-details.html"
							   class="text-animation-line text-h3 text-n20 font-otomanopee fw-normal mb-4 hover-underline">
								Cat
								Care
							</a>
							<p class="text-n20">
								At PetPath, we offer specialized cat care services including grooming, boarding, and
								in-home visits. Our dedicated team
							</p>
						</div>
					</div>
					<div class="col-lg-4 col-md-6 col-xs-10">
						<div class="service-card position-relative text-center py-xl-20 py-lg-15 py-sm-12 py-18 px-xl-10 px-sm-8 px-10 border n20-border radius-circle bg-secondary4 overflow-hidden">
							<div class="dog-paws position-absolute end-0 top-0 me-10 mt-10">
								<img class="w-100" src="/images/dog-paws.png" alt="">
							</div>
							<div class="icon-80px mx-auto radius-0 mb-lg-8 mb-6">
								<img class="w-100" src="/images/service-icon-3.png" alt="dog icon">
							</div>
							<a href="service-details.html"
							   class="text-animation-line text-h3 text-n20 font-otomanopee fw-normal mb-4 hover-underline">
								Pet
								Grooming
							</a>
							<p class="text-n20">
								Keep your pets looking their best with our full-service grooming. From baths to nail
								trims, our expert groomers.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- about us section end -->
		<!-- why choose us section -->
		<!-- why choose us section start -->
		<section class="choose-us-section pt-120 pb-120 bg-primary2 mb-10" style="padding: 50px 100px 0px 100px;">
			<div class="container">
				<div class="row justify-content-center mb-lg-15 mb-md-10 mb-8 position-relative">
					<div class="col-xl-6 col-lg-8 text-center px-lg-0">
						<span class="d-block text-primary text-uppercase mb-lg-4 mb-3">WHY CHOOSE US</span>
						<h2 class="text-animation-word text-h1 text-center font-otomanopee text-n20 fw-normal">
							Your Pets Will Be Extremely
							Happy With Us
						</h2>
					</div>
					<div class="icon-80px position-absolute start-0 top-100">
						<img class="w-100" src="/images/spiral-1.png" alt="spiral shape">
					</div>
					<div class="icon-80px position-absolute end-0 top-100">
						<img class="w-100" src="/images/spiral-2.png" alt="spiral shape">
					</div>
				</div>

				<div class="row gy-6 gy-md-0 position-relative d-center justify-content-start justify-content-md-center">
					<div class="col-md-3 d-center order-1 order-md-0">
						<div class="items-wrapper start-0 d-center flex-column gap-lg-20 gap-md-10 gap-6 text-end">
							<div class="single-area d-flex align-items-md-center gap-2 gap-md-4 justify-content-end">
								<div class="content-area text-start text-md-end order-1 order-md-0">
									<h4 class="font-playfair mb-3">Experienced Professionals</h4>
									<p>
										Our team consists of highly trained and passionate pet care experts dedicated to
										ensuring your pet's well-being.
									</p>
								</div>
								<div class="img-area box-style box-primary p-lg-4 p-2">
									<span class="icon-area d-block p-lg-6 p-md-4 p-2 radius-circle">
										<img class="transition w-100" src="/images/choose-us-icon-1.png" alt="Icon">
									</span>
								</div>
							</div>
							<div class="single-area d-flex align-items-md-center gap-2 gap-md-4 justify-content-end">
								<div class="content-area text-start text-md-end order-1 order-md-0">
									<h4 class="font-playfair mb-3">Loving Environment</h4>
									<p>
										We prioritize your pet's safety and comfort, providing a nurturing and secure
										setting for them to thrive.
									</p>
								</div>
								<div class="img-area box-style box-primary p-lg-4 p-2">
									<span class="icon-area d-block p-lg-6 p-md-4 p-2 radius-circle">
										<img class="transition w-100" src="/images/choose-us-icon-2.png" alt="Icon">
									</span>
								</div>
							</div>
						</div>
					</div>
					<div class="col-md-5 col-sm-12 position-relative z-n1">
						<div class="icon-80px position-absolute top-0 start-0 d-none d-lg-block">
							<img class="w-100" src="/images/bright-star.png" alt="bright start">
						</div>
						<div class="icon-100px position-absolute top-5 end-0 d-none d-lg-block">
							<img class="w-100" src="/images/rain-drop.png" alt="bright start">
						</div>
						<div class="choose-us-area cus-z-1 d-none d-md-block">
							<img src="/images/why-choose-us-banner.png" class="w-100 rounded-pill" alt="Icon">
						</div>
					</div>
					<div class="col-md-3 d-center">
						<div class="items-wrapper end-0 d-center flex-column gap-lg-20 gap-md-10 gap-6">
							<div class="single-area d-flex align-items-md-center gap-2 gap-md-4 justify-content-end">
								<div class="content-area order-1">
									<h4 class="font-playfair mb-3">Comprehensive Services</h4>
									<p>
										From grooming to boarding, we offer a wide range of services to meet all your
										pet's needs under one roof.
									</p>
								</div>
								<div class="img-area box-style box-primary p-lg-4 p-2">
									<span class="icon-area d-block p-lg-6 p-md-4 p-2 radius-circle">
										<img class="transition w-100" src="/images/choose-us-icon-3.png" alt="Icon">
									</span>
								</div>
							</div>
							<div class="single-area d-flex align-items-md-center gap-2 gap-md-4 justify-content-end">
								<div class="content-area order-1">
									<h4 class="font-playfair mb-3">Customer Satisfaction</h4>
									<p>
										We pride ourselves on exceptional customer service, with numerous happy clients
										who trust us.
									</p>
								</div>
								<div class="img-area box-style box-primary p-lg-4 p-2">
									<span class="icon-area d-block p-lg-6 p-md-4 p-2 radius-circle">
										<img class="transition w-100" src="/images/choose-us-icon-4.png" alt="Icon">
									</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
	<!-- main end -->
	<!-- footer -->
	@Html.Partial("PageCommon/PageFooter")

</body>